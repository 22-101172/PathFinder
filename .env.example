# Copy this file to `.env` and fill in the real secret values before running the application.
# Keep this file checked into version control; do NOT include real secrets here.

# ── Neo4j / Knowledge Graph ───────────────────────────────────────────────────
NEO4J_URI=bolt://your_neo4j_host:7687
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ── RAG Engine / Groq ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_rag_llm_model_here

# ── Gateway LLM Client (Query Understanding & Composer) ───────────────────────
# Shared OpenAI-compatible client. Currently configured for Groq.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_TIMEOUT_SECONDS=30

# ── Query Understanding (QU) — Model Chain ─────────────────────────────────────
# QU tries models in order: primary first, then QU_FALLBACK_MODELS (comma-separated).
# On timeout / 429 / invalid JSON / unrecognized intent → next model.
# If all fail → deterministic keyword fallback.
QU_PRIMARY_MODEL=llama-3.3-70b-versatile
QU_FALLBACK_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3-32b,llama-3.1-8b-instant
# QU_TIMEOUT_SECONDS is reserved for future use.
# Currently NOT wired: LLMClient.chat() uses the shared LLM_TIMEOUT_SECONDS set at construction.
# To control QU call timeout today, set LLM_TIMEOUT_SECONDS above.
QU_TIMEOUT_SECONDS=20

# ── Response Composer — Model Chain ──────────────────────────────────────────
# Composer uses a separate model chain so QU and Composer can be tuned independently.
# Set COMPOSER_USE_LLM=false to force deterministic fallback (useful in CI/testing).
COMPOSER_USE_LLM=true
COMPOSER_PRIMARY_MODEL=qwen/qwen3-32b
COMPOSER_FALLBACK_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# ── Session Management ────────────────────────────────────────────────────────
SESSION_DB_PATH=pathfinder_sessions.db
QU_CONTEXT_TURNS=5

# ── Optional / Development ────────────────────────────────────────────────────
PATHFINDER_API_URL=http://localhost:8000
