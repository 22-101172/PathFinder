# Copy this file to `.env` and fill in the real secret values before running the application.
# Keep this file checked into version control; do NOT include real secrets here.

# ── Neo4j / Knowledge Graph ───────────────────────────────────────────────────
NEO4J_URI=bolt://your_neo4j_host:7687
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ── RAG Engine / Groq ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=your_rag_llm_model_here

# ── Gateway LLM Client (Query Understanding & Composer) — TBD ─────────────────
# Shared client used by both the QueryUnderstandingLayer and ResponseComposer.
# Model/provider/URL to be decided during QU and Composer design phase.
LLM_PROVIDER=your_llm_provider_here
LLM_BASE_URL=your_llm_base_url_here
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_llm_model_here
LLM_TIMEOUT_SECONDS=30

# ── Session Management ────────────────────────────────────────────────────────
SESSION_DB_PATH=pathfinder_sessions.db
QU_CONTEXT_TURNS=5

# ── Optional / Development ────────────────────────────────────────────────────
PATHFINDER_API_URL=http://localhost:8000
