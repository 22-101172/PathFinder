# Copy this file to `.env` and fill in the real secret values before running the application.
# Keep this file checked into version control; do NOT include real secrets here.

# LLM / OpenAI-style settings
LLM_PROVIDER=groq                # e.g. groq, openai, anthropic
LLM_BASE_URL=https://api.example.com/openai/v1  # provider base URL
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_COMPOSER=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# Neo4j settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Temporary RAG Colab/localtunnel endpoint. Used only while teammate RAG solution is pending.
COLAB_LLM_URL=

# Optional: add any environment-specific overrides below
# STREAMLIT_SERVER_PORT=8501
# LOG_LEVEL=info