# PathFinder - Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env to git.

# ── Neo4j database (KG adapter) ───────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Shared LLM client ─────────────────────────────────────────────────────────
# Used by:
#   - QueryUnderstandingLayer (Layer 2 fallback when rules cannot classify)
#   - ResponseComposer        (primary text generation, with safe fallback)
#
# Any provider exposing the OpenAI Chat Completions shape works:
#   - Groq:       https://api.groq.com/openai/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - Mistral:    https://api.mistral.ai/v1
#   - Local Ollama: http://localhost:11434/v1
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=20

# Optional stronger model used only by ResponseComposer. If empty, falls back
# to LLM_MODEL.
LLM_MODEL_COMPOSER=

# ── KG reference data ─────────────────────────────────────────────────────────
# Folder containing courses.csv, roles.csv, tracks.csv, skills.csv.
# When unset the loader falls back to <repo>/data/kg/ and then to a built-in
# starter dataset (a one-time warning is logged).
KG_DATA_DIR=

# ── RAG answer-generation endpoint (existing) ─────────────────────────────────
# Used by gateway/adapters/rag_adapter.py — distinct from the shared LLM
# client above. Switching the gateway LLM does not affect this URL.
COLAB_LLM_URL=

# ── Session storage ───────────────────────────────────────────────────────────
# 'memory' is the only supported mode today. 'redis' is a future migration.
SESSION_STORE=memory
