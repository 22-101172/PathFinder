# Copy this file to `.env` and fill in the real secret values before running the application.
# Keep this file checked into version control; do NOT include real secrets here.

# ── Neo4j / Knowledge Graph ───────────────────────────────────────────────────
NEO4J_URI=uri_to_your_neo4j_instance_here
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database_name
NEO4J_Import_folder=path_to_your_neo4j_import_folder

# ── RAG Engine / Groq ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Primary RAG model. Falls back to GROQ_MODEL then the built-in default if unset.
RAG_GROQ_MODEL=your_primary_rag_model_here
# Comma-separated fallback models tried in order when the primary fails.
RAG_FALLBACK_MODELS=your_rag_fallback_models_here_comma_separated
# Reasoning effort for openai/gpt-oss-* models only. Ignored for other models.
RAG_REASONING_EFFORT=low|medium|high
RAG_TIMEOUT_SECONDS=60
# Delay (in seconds) between LLM calls during startup rule-bundle extraction.
RAG_RULE_BUNDLE_DELAY_SECONDS=2.0  # Increase if Groq rate limits or overload errors occur at startup.
RAG_HANDBOOK_PATH=path_to_your_rag_handbook_file_here
RAG_CHROMA_DIR=path_to_your_rag_chroma_directory_here
RAG_CHUNKS_FILE=path_to_your_rag_chunks_file_here

# ── Shared LLM Client (Query Understanding & Composer) ───────────────────────
# Shared OpenAI-compatible credentials.
LLM_PROVIDER=shared_llm_provider_name_here
LLM_BASE_URL=your_llm_api_base_url_here
LLM_API_KEY=your_llm_api_key_here
# Default model used when no per-component model is configured (default: llama-3.1-8b-instant)
LLM_MODEL=your_default_llm_model_here
# Default timeout in seconds for LLM calls (default: 20)
LLM_TIMEOUT_SECONDS=20


# ── Query Understanding (QU) — Model Chain ─────────────────────────────────────
QU_PRIMARY_MODEL=your_qu_primary_model_here
QU_FALLBACK_MODELS=your_qu_fallback_models_here_comma_separated
QU_TIMEOUT_SECONDS=30

# ── Response Composer — Model Chain ──────────────────────────────────────────
COMPOSER_USE_LLM=use_llm_for_composer_true_or_false
COMPOSER_PRIMARY_MODEL=your_composer_primary_model_here
COMPOSER_FALLBACK_MODELS=your_composer_fallback_models_here_comma_separated
COMPOSER_TIMEOUT_SECONDS=30

# ── Session Management ────────────────────────────────────────────────────────
SESSION_DB_PATH=./pathfinder_sessions.db
QU_CONTEXT_TURNS=5

# ── Optional / Development ────────────────────────────────────────────────────
PATHFINDER_API_URL=http://localhost:8000

# Set to true to emit structured trace blocks (Turn Start/End, QU, Orchestrator, Composer, KGAdapter) at INFO level.
# Useful for diagnosing which pipeline component caused a failure. Never enable in production.
PATHFINDER_TRACE=false

# Dev-only endpoints (DELETE /dev/...) require APP_ENV=dev OR DEV_MODE=true.
# Do NOT set these in production.
APP_ENV=dev|prod
DEV_MODE=true|false

# Optional: Hugging Face token for smoother/faster model downloads and higher unauthenticated limits. Do not commit real tokens.
HF_TOKEN=your_hugging_face_token_here

# -- SAE / Student Analysis Engine ----------------------------------------------------
# SAE runs as a separate service. Start it with:
#   uvicorn engines.sae.api:app --port 8502
SAE_BASE_URL=http://localhost:8502
SAE_TIMEOUT_SECONDS=30
