# SAE (Student Analysis Engine) — environment variables
# Copy this file to SAE/.env and fill in real values before starting SAE.
# SAE is started independently: cd SAE/ && uvicorn sae.api:app --port 8502

# ── LLM / Groq (used by llm_client.py for advisor session guides) ────────────
# If unset, LLM features are silently disabled; all analysis still works.
GROQ_API_KEY=your_groq_api_key_here

# OpenAI-compatible base URL (defaults to https://api.groq.com/openai/v1 if unset)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model to use for LLM calls (defaults to llama-3.3-70b-versatile if unset)
LLM_MODEL=llama-3.3-70b-versatile
