# PathFinder — Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env to git.

# Neo4j database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Internal service URLs (used by gateway to reach engines inside Docker network)
KG_ENGINE_URL=http://kg-engine:8001
RAG_ENGINE_URL=http://rag-engine:8002

# LLM API — used by Query Understanding (fallback) and Response Composer
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com        # or your provider's base URL
LLM_MODEL=claude-sonnet-4-20250514            # or your preferred model

# Session storage: 'memory' for now, 'redis' when needed later
SESSION_STORE=memory
