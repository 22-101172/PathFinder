# PathFinder - Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env to git.

# Neo4j database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Hosted LLM API - used by Query Understanding (fallback) and Response Composer
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-20250514

# Current RAG answer-generation endpoint used by gateway/adapters/rag_adapter.py
COLAB_LLM_URL=

# Session storage: 'memory' for now, 'redis' when needed later
SESSION_STORE=memory
